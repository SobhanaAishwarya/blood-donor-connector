# ---------------------------------------------------------------------------
# Blood Donor Connector - environment configuration
# Copy this file to `.env` and adjust as needed. The app runs fine with the
# defaults below - no external / paid services are required for the demo.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production-please
PORT=5000

# Database
# SQLite by default. To migrate to PostgreSQL later, just point this at
# e.g. postgresql+psycopg://user:pass@localhost:5432/blood_connector
DATABASE_URL=sqlite:///database/blood_connector.db

# Auth
JWT_EXPIRES_DAYS=7

# Ring-based fan-out matching
RING_TIMEOUT_MINUTES=15
MAX_DONORS_PER_RING=5

# Seed the demo dataset automatically the first time the app boots against an
# empty database (never touches a database that already has users). Handy on
# free/ephemeral hosting where the disk can reset. Set to false once you're
# running with real data.
AUTO_SEED_DEMO_DATA=true

# Map experience. Left blank the app uses its built-in animated ring/fan-out
# visualisation (no API key, works offline). These vars are surfaced to the
# client via /api/config so a real tile map can be wired in later without
# code changes.
MAP_PROVIDER=
MAP_TILE_URL=
